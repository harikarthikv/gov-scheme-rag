DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional — swap models without code changes
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_MODEL=deepseek-v4-pro

# Bounded answers rather than spending the token budget on reasoning.
DEEPSEEK_THINKING=disabled
RAG_MAX_TOKENS=1024

# Retrieval: baseline | dense | bm25 | hybrid
RAG_RETRIEVAL_MODE=hybrid
RAG_TOP_K=5
RAG_CANDIDATE_K=30
RAG_DENSE_WEIGHT=0.5
RAG_RRF_CONSTANT=60
# Applies only to baseline/dense, never to BM25/RRF/cross-encoder scores.
RAG_SIMILARITY_THRESHOLD=0.3
# Optional; downloads a model. Benchmark on dev before enabling.
# RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2

RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_EMBEDDING_DEVICE=cpu
# Set to 1 to require locally cached embedding models.
RAG_LOCAL_MODELS_ONLY=0
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
# Changing embedding model, prefixes or chunking requires a NEW collection.
RAG_COLLECTION=gov_schemes_local_dataset
RAG_DB_PATH=chroma_db
RAG_DATA_DIR=data/text_data
# For E5, use query/document prefixes required by that model's card.
# RAG_QUERY_PREFIX="query: "
# RAG_DOCUMENT_PREFIX="passage: "
# RAG_JUDGE_MODEL=deepseek-v4-pro
